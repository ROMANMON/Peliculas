<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StreamVibe Pro - Tu plataforma de streaming</title>
    <style>
        :root {
            --bg-primary: #141414;
            --bg-secondary: #1f1f1f;
            --accent: #e50914;
            --accent-hover: #b20710;
            --text-main: #ffffff;
            --text-muted: #b3b3b3;
            --card-bg: #2f2f2f;
            --success: #2ecc71;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            min-height: 100vh;
        }

        .view {
            display: none;
            padding: 20px;
        }

        .view.active {
            display: block;
        }

        /* Autenticación */
        .auth-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1574375927938-d5a98e8ffe85?auto=format&fit=crop&w=1920&q=80') no-repeat center center/cover;
        }

        .auth-card {
            background-color: rgba(0, 0, 0, 0.85);
            padding: 40px;
            border-radius: 8px;
            width: 100%;
            max-width: 400px;
        }

        .auth-card h2 {
            margin-bottom: 24px;
            font-size: 2rem;
            color: var(--accent);
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 12px;
            background-color: var(--bg-secondary);
            border: 1px solid #333;
            border-radius: 4px;
            color: var(--text-main);
            font-size: 1rem;
        }

        .form-group input:focus, .form-group select:focus {
            outline: none;
            border-color: var(--accent);
        }

        .btn {
            width: 100%;
            padding: 12px;
            background-color: var(--accent);
            color: var(--text-main);
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn:hover {
            background-color: var(--accent-hover);
        }

        .auth-switch {
            margin-top: 16px;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .auth-switch a {
            color: var(--text-main);
            text-decoration: none;
            font-weight: bold;
        }

        /* Navbar */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 40px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid #222;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--accent);
            letter-spacing: 1px;
            cursor: pointer;
        }

        .user-menu {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-menu span {
            color: var(--text-muted);
        }

        .btn-small {
            padding: 6px 12px;
            font-size: 0.85rem;
            width: auto;
        }

        /* Planes y Pasarela */
        .plans-container {
            max-width: 1000px;
            margin: 40px auto;
            text-align: center;
        }

        .plans-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            text-align: left;
            margin-top: 30px;
        }

        .plan-card {
            background-color: var(--bg-secondary);
            border: 2px solid #333;
            border-radius: 8px;
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .plan-card.featured {
            border-color: var(--accent);
        }

        .plan-price {
            font-size: 2rem;
            font-weight: bold;
            color: var(--accent);
            margin-bottom: 20px;
        }

        .plan-features {
            list-style: none;
            margin-bottom: 30px;
            color: var(--text-muted);
        }

        .plan-features li {
            margin-bottom: 10px;
        }

        /* Modal de Pago */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.8);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-content {
            background: var(--bg-secondary);
            padding: 30px;
            border-radius: 8px;
            width: 100%;
            max-width: 400px;
        }

        .modal-content h3 {
            margin-bottom: 20px;
        }

        /* Dashboard y Admin */
        .dashboard-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .hero-banner {
            background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.8)), url('https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=1200&q=80') no-repeat center center/cover;
            height: 400px;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 40px;
            margin-bottom: 40px;
        }

        .movie-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
        }

        .movie-card {
            background-color: var(--card-bg);
            border-radius: 4px;
            overflow: hidden;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .movie-card:hover { transform: scale(1.05); }
        .movie-card img { width: 100%; height: 280px; object-fit: cover; }
        .movie-info { padding: 12px; }

        /* Panel Admin Estilos */
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background: var(--bg-secondary);
            border-radius: 8px;
            overflow: hidden;
        }

        .admin-table th, .admin-table td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #333;
        }

        .admin-table th {
            background-color: #222;
        }

        .badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            background: var(--accent);
        }

        .badge.active { background: var(--success); }

        .error-msg {
            color: var(--accent);
            font-size: 0.85rem;
            margin-bottom: 10px;
            display: none;
        }
    </style>
</head>
<body>

    <!-- VISTA: LOGIN -->
    <div id="login-view" class="view auth-container active">
        <div class="auth-card">
            <h2>Iniciar Sesión</h2>
            <div id="login-error" class="error-msg"></div>
            <form onsubmit="handleLogin(event)">
                <div class="form-group">
                    <label>Correo Electrónico (Usa "director@streamvibe.com")</label>
                    <input type="email" id="login-email" required placeholder="usuario@correo.com">
                </div>
                <div class="form-group">
                    <label>Contraseña</label>
                    <input type="password" id="login-password" required placeholder="••••••••">
                </div>
                <button type="submit" class="btn">Entrar</button>
            </form>
            <div class="auth-switch">
                ¿No tienes cuenta? <a href="#" onclick="switchView('register-view')">Regístrate aquí</a>
            </div>
        </div>
    </div>

    <!-- VISTA: REGISTRO -->
    <div id="register-view" class="view auth-container">
        <div class="auth-card">
            <h2>Crear Cuenta</h2>
            <div id="reg-error" class="error-msg"></div>
            <form onsubmit="handleRegister(event)">
                <div class="form-group">
                    <label>Nombre Completo</label>
                    <input type="text" id="reg-name" required placeholder="Tu Nombre">
                </div>
                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" id="reg-email" required placeholder="usuario@correo.com">
                </div>
                <div class="form-group">
                    <label>Contraseña</label>
                    <input type="password" id="reg-password" required placeholder="••••••••">
                </div>
                <button type="submit" class="btn">Registrarse</button>
            </form>
            <div class="auth-switch">
                ¿Ya tienes cuenta? <a href="#" onclick="switchView('login-view')">Inicia sesión</a>
            </div>
        </div>
    </div>

    <!-- VISTA: PLANES -->
    <div id="plans-view" class="view">
        <div class="plans-container">
            <h2>Elige el plan ideal para ti</h2>
            <p style="color: var(--text-muted);">Proceso de pago simulado con tarjeta.</p>
            <div class="plans-grid">
                <div class="plan-card">
                    <div>
                        <h3>Básico</h3>
                        <div class="plan-price">$99 / mes</div>
                        <ul class="plan-features">
                            <li>✔ Calidad 720p</li>
                            <li>✔ 1 Dispositivo</li>
                            <li>✔ Sin anuncios</li>
                        </ul>
                    </div>
                    <button class="btn" onclick="openCheckout('Básico', 99)">Elegir Plan</button>
                </div>
                <div class="plan-card featured">
                    <div>
                        <h3>Estándar</h3>
                        <div class="plan-price">$169 / mes</div>
                        <ul class="plan-features">
                            <li>✔ Calidad 1080p (FHD)</li>
                            <li>✔ 2 Dispositivos</li>
                            <li>✔ Sin anuncios</li>
                        </ul>
                    </div>
                    <button class="btn" onclick="openCheckout('Estándar', 169)">Elegir Plan</button>
                </div>
                <div class="plan-card">
                    <div>
                        <h3>Premium</h3>
                        <div class="plan-price">$229 / mes</div>
                        <ul class="plan-features">
                            <li>✔ Calidad 4K + HDR</li>
                            <li>✔ 4 Dispositivos</li>
                            <li>✔ Audio espacial</li>
                        </ul>
                    </div>
                    <button class="btn" onclick="openCheckout('Premium', 229)">Elegir Plan</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL PASARELA DE PAGO -->
    <div id="checkout-modal" class="modal">
        <div class="modal-content">
            <h3 id="modal-plan-title">Suscribirse al plan</h3>
            <form onsubmit="processPayment(event)">
                <div class="form-group">
                    <label>Nombre en la tarjeta</label>
                    <input type="text" required placeholder="Ej. Juan Pérez">
                </div>
                <div class="form-group">
                    <label>Número de Tarjeta</label>
                    <input type="text" required placeholder="4532 •••• •••• ••••" maxlength="19">
                </div>
                <div style="display: flex; gap: 10px;">
                    <div class="form-group" style="flex: 1;">
                        <label>Expiración</label>
                        <input type="text" required placeholder="MM/AA" maxlength="5">
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label>CVV</label>
                        <input type="password" required placeholder="123" maxlength="4">
                    </div>
                </div>
                <button type="submit" class="btn" style="margin-top: 10px;">Pagar y Activar</button>
                <button type="button" class="btn" style="background: #444; margin-top: 8px;" onclick="closeCheckout()">Cancelar</button>
            </form>
        </div>
    </div>

    <!-- VISTA: DASHBOARD -->
    <div id="dashboard-view" class="view">
        <nav class="navbar">
            <div class="logo" onclick="switchView('dashboard-view')">StreamVibe</div>
            <div class="user-menu">
                <span id="user-display-name">Usuario</span>
                <button id="admin-nav-btn" class="btn btn-small" style="background: #333; display:none;" onclick="switchView('admin-view')">Panel Admin</button>
                <button class="btn btn-small" onclick="logout()">Cerrar Sesión</button>
            </div>
        </nav>
        <div class="dashboard-container">
            <div class="hero-banner">
                <h1>Cyberpunk: Edgerunners</h1>
                <p>Un chico callejero intenta sobrevivir en una ciudad obsesionada con los implantes tecnológicos.</p>
                <button class="btn btn-small" style="width: 150px;" onclick="playMovie('Cyberpunk')">▶ Reproducir</button>
            </div>
            <h3 style="margin-bottom: 20px;">Catálogo Disponible</h3>
            <div class="movie-grid">
                <div class="movie-card" onclick="playMovie('Acción Extrema')">
                    <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=400&q=80" alt="Película">
                    <div class="movie-info">
                        <h4>Acción Extrema</h4>
                        <p>2025 • Acciones</p>
                    </div>
                </div>
                <div class="movie-card" onclick="playMovie('Misterio en la Red')">
                    <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=400&q=80" alt="Película">
                    <div class="movie-info">
                        <h4>Misterio en la Red</h4>
                        <p>2026 • Suspenso</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- VISTA: PANEL DE ADMINISTRACIÓN -->
    <div id="admin-view" class="view">
        <nav class="navbar">
            <div class="logo" onclick="switchView('dashboard-view')">StreamVibe (Admin)</div>
            <button class="btn btn-small" onclick="switchView('dashboard-view')">Volver al Sitio</button>
        </nav>
        <div class="dashboard-container">
            <h2 style="margin-bottom: 10px;">Panel de Control Administrativo</h2>
            <p style="color: var(--text-muted); margin-bottom: 20px;">Gestión general de usuarios registrados y planes activos.</p>
            
            <div style="display: flex; gap: 20px; margin-bottom: 30px;">
                <div style="background: var(--bg-secondary); padding: 20px; border-radius: 8px; flex: 1;">
                    <h4 style="color: var(--text-muted);">Total de Usuarios</h4>
                    <p id="stat-total-users" style="font-size: 2rem; font-weight: bold; color: var(--accent);">0</p>
                </div>
                <div style="background: var(--bg-secondary); padding: 20px; border-radius: 8px; flex: 1;">
                    <h4 style="color: var(--text-muted);">Suscripciones Activas</h4>
                    <p id="stat-active-subs" style="font-size: 2rem; font-weight: bold; color: var(--success);">0</p>
                </div>
            </div>

            <h3>Base de Datos de Usuarios</h3>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Plan Actual</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="admin-users-table">
                    <!-- Dinámico -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- VISTA: REPRODUCTOR -->
    <div id="player-view" class="view">
        <nav class="navbar">
            <div class="logo" onclick="switchView('dashboard-view')">← Volver</div>
        </nav>
        <div style="max-width: 900px; margin: 40px auto; text-align: center;">
            <h2 id="movie-title" style="margin-bottom: 20px;">Reproduciendo</h2>
            <div style="position: relative; padding-bottom: 56.25%; height: 0; background: #000; border-radius: 8px; overflow: hidden;">
                <iframe src="https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?autoplay=1" style="position: absolute; top:0; left:0; width:100%; height:100%; border:0;" allow="autoplay; encrypted-media" allowfullscreen></iframe>
            </div>
        </div>
    </div>

    <script>
        // AQUÍ PUEDES CAMBIAR LA PALABRA CLAVE SECRETA PARA EL PANEL
        const PALABRA_SECRETA = "director"; 

        // Inicializar Base de Datos en localStorage si no existe
        if (!localStorage.getItem('sv_users')) {
            localStorage.setItem('sv_users', JSON.stringify([
                { name: 'Director General', email: 'director@streamvibe.com', password: '123', plan: 'Premium', status: 'Activo' },
                { name: 'Usuario Prueba', email: 'user@correo.com', password: '123', plan: 'Básico', status: 'Activo' }
            ]));
        }

        let currentSession = JSON.parse(localStorage.getItem('sv_session')) || null;
        let selectedPlanTemp = { name: '', price: 0 };

        window.onload = function() {
            if (currentSession) {
                initUserSession(currentSession);
            }
        };

        function switchView(viewId) {
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.getElementById(viewId).classList.add('active');
            window.scrollTo(0, 0);
            if (viewId === 'admin-view') loadAdminPanel();
        }

        function showError(elementId, msg) {
            const el = document.getElementById(elementId);
            el.innerText = msg;
            el.style.display = 'block';
        }

        function handleRegister(e) {
            e.preventDefault();
            const name = document.getElementById('reg-name').value;
            const email = document.getElementById('reg-email').value;
            const password = document.getElementById('reg-password').value;

            let users = JSON.parse(localStorage.getItem('sv_users'));
            if (users.some(u => u.email === email)) {
                showError('reg-error', 'El correo electrónico ya está registrado.');
                return;
            }

            const newUser = { name, email, password, plan: null, status: 'Inactivo' };
            users.push(newUser);
            localStorage.setItem('sv_users', JSON.stringify(users));

            currentSession = newUser;
            localStorage.setItem('sv_session', JSON.stringify(currentSession));
            switchView('plans-view');
        }

        function handleLogin(e) {
            e.preventDefault();
            const email = document.getElementById('login-email').value;
            const password = document.getElementById('login-password').value;

            let users = JSON.parse(localStorage.getItem('sv_users'));
            const user = users.find(u => u.email === email && u.password === password);

            if (!user) {
                showError('login-error', 'Correo o contraseña incorrectos.');
                return;
            }

            currentSession = user;
            localStorage.setItem('sv_session', JSON.stringify(currentSession));
            initUserSession(user);
        }

        function initUserSession(user) {
            document.getElementById('user-display-name').innerText = user.name;
            
            // Verifica si el correo contiene la palabra secreta configurada
            if (user.email.includes(PALABRA_SECRETA)) {
                document.getElementById('admin-nav-btn').style.display = 'block';
            } else {
                document.getElementById('admin-nav-btn').style.display = 'none';
            }

            if (!user.plan) {
                switchView('plans-view');
            } else {
                switchView('dashboard-view');
            }
        }

        function openCheckout(planName, price) {
            selectedPlanTemp = { name: planName, price: price };
            document.getElementById('modal-plan-title').innerText = `Suscribirse al Plan ${planName} ($${price}/mes)`;
            document.getElementById('checkout-modal').style.display = 'flex';
        }

        function closeCheckout() {
            document.getElementById('checkout-modal').style.display = 'none';
        }

        function processPayment(e) {
            e.preventDefault();
            alert('¡Pago procesado con éxito! Suscripción activada.');
            
            let users = JSON.parse(localStorage.getItem('sv_users'));
            let userIndex = users.findIndex(u => u.email === currentSession.email);
            
            if (userIndex !== -1) {
                users[userIndex].plan = selectedPlanTemp.name;
                users[userIndex].status = 'Activo';
                currentSession = users[userIndex];
                localStorage.setItem('sv_users', JSON.stringify(users));
                localStorage.setItem('sv_session', JSON.stringify(currentSession));
            }

            closeCheckout();
            switchView('dashboard-view');
        }

        function loadAdminPanel() {
            let users = JSON.parse(localStorage.getItem('sv_users'));
            document.getElementById('stat-total-users').innerText = users.length;
            document.getElementById('stat-active-subs').innerText = users.filter(u => u.status === 'Activo').length;

            const tbody = document.getElementById('admin-users-table');
            tbody.innerHTML = '';

            users.forEach((u, index) => {
                tbody.innerHTML += `
                    <tr>
                        <td>${u.name}</td>
                        <td>${u.email}</td>
                        <td>${u.plan || 'Ninguno'}</td>
                        <td><span class="badge ${u.status === 'Activo' ? 'active' : ''}">${u.status}</span></td>
                        <td>
                            <button class="btn btn-small" style="background:#e50914;" onclick="adminDeleteUser(${index})">Eliminar</button>
                        </td>
                    </tr>
                `;
            });
        }

        function adminDeleteUser(index) {
            let users = JSON.parse(localStorage.getItem('sv_users'));
            if (users[index].email === currentSession.email) {
                alert('No puedes eliminar tu propia sesión activa.');
                return;
            }
            users.splice(index, 1);
            localStorage.setItem('sv_users', JSON.stringify(users));
            loadAdminPanel();
        }

        function playMovie(title) {
            document.getElementById('movie-title').innerText = `Reproduciendo: ${title}`;
            switchView('player-view');
        }

        function logout() {
            currentSession = null;
            localStorage.removeItem('sv_session');
            document.getElementById('login-email').value = '';
            document.getElementById('login-password').value = '';
            switchView('login-view');
        }
    </script>
</body>
</html>
